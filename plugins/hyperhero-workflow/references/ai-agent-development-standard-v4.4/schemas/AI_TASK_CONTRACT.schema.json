{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-essd/v4.4/AI_TASK_CONTRACT.schema.json",
  "title": "AI Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "stage",
    "risk",
    "baseline_digest",
    "requirement_ids",
    "goal",
    "allowed_paths",
    "forbidden_paths",
    "required_gates"
  ],
  "properties": {
    "schema_version": {
      "const": "4.4.0"
    },
    "task_id": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "L0-MVP",
        "L1-FORMAL-PROJECT",
        "L2-INTERNAL-TEST",
        "L3-PILOT",
        "L4-GENERAL-AVAILABILITY",
        "L5-MAINTENANCE",
        "L6-RETIREMENT"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "baseline_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(ARCH|SEC|DATA|TEST|MGMT|UI|AI|DEV)-REQ-[0-9]{3}$"
      }
    },
    "goal": {
      "type": "string"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
